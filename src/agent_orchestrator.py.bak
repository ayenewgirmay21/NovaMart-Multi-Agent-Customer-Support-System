import os
import sys
import time
import uuid
from decimal import Decimal, ROUND_HALF_UP
import boto3
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Any
from strands import Agent
from strands.models import BedrockModel
import config
from src.agent_utils import AgentTrace
from src.agent_observability import tool as traced_tool
from src.bedrock_kb_retrieval import retrieve_from_knowledge_base
logger = logging.getLogger(__name__)
dynamodb = boto3.resource("dynamodb", region_name=config.AWS_REGION)
bedrock = boto3.client("bedrock", region_name=config.AWS_REGION)
orders_table = dynamodb.Table(config.ORDERS_TABLE)
customers_table = dynamodb.Table(config.CUSTOMERS_TABLE)
workflow_table = dynamodb.Table(config.WORKFLOW_STATE_TABLE)
def _create_workflow_state(session_id: str, customer_id: str) -> dict:
    """Create a new version-1 WorkflowState record."""
    item = {"session_id": session_id, "customer_id": customer_id, "version": 1,
            "status": "INITIALIZED", "inventory_findings": None,
            "policy_findings": None, "refund_decision": None, "final_response": None}
    workflow_table.put_item(Item=item)
    return item
def _read_workflow_state(session_id: str) -> dict:
    """Read the current WorkflowState record."""
    return workflow_table.get_item(Key={"session_id": session_id}).get("Item", {})
def _update_workflow_state(session_id: str, updates: dict, expected_version: int) -> dict:
    """Update WorkflowState only when its current version matches expected_version."""
    from botocore.exceptions import ClientError
    names = {f"#{k}": k for k in updates}
    values = {f":{k}": v for k, v in updates.items()}
    names["#version"] = "version"
    values[":expected_version"] = expected_version
    values[":new_version"] = expected_version + 1
    expr = [f"#{k} = :{k}" for k in updates] + ["#version = :new_version"]
    try:
        return workflow_table.update_item(
            Key={"session_id": session_id}, UpdateExpression="SET " + ", ".join(expr),
            ConditionExpression="#version = :expected_version",
            ExpressionAttributeNames=names, ExpressionAttributeValues=values,
            ReturnValues="ALL_NEW")["Attributes"]
    except ClientError as exc:
        if exc.response["Error"]["Code"] == "ConditionalCheckFailedException":
            logger.warning("WorkflowState version conflict for %s", session_id)
        raise
def _apply_guardrail(model_kwargs: dict) -> dict:
    """Attach the configured published Bedrock Guardrail to every agent model.

    The same model factory is used by the Orchestrator, Inventory, Policy,
    Refund, Communication, and policy-retriever agents, so the safety settings
    cannot silently diverge between agent construction paths.
    """
    kwargs = dict(model_kwargs)
    guardrail_id = getattr(config, "GUARDRAIL_ID", "")
    guardrail_version = getattr(config, "GUARDRAIL_VERSION", "")
    if guardrail_id and guardrail_version:
        kwargs.update(
            guardrail_id=guardrail_id,
            guardrail_version=guardrail_version,
            guardrail_trace="enabled",
        )
    return kwargs


def _model(temperature: float, orchestrator: bool = False) -> BedrockModel:
    """Build a Bedrock model and consistently apply the configured guardrail."""
    model_id = config.ORCHESTRATOR_MODEL_ID if orchestrator else config.WORKER_MODEL_ID
    kwargs = _apply_guardrail({"model_id": model_id, "temperature": temperature})
    return BedrockModel(**kwargs)
@traced_tool
def check_order_status(customer_id: str, order_id: str) -> dict:
    """Look up an order's status, dates, amount and item details."""
    item = orders_table.get_item(
        Key={"customer_id": customer_id, "order_id": order_id}).get("Item")
    return item or {"error": f"Order {order_id} not found for customer {customer_id}"}
@traced_tool
def get_customer_tier(customer_id: str) -> dict:
    """Retrieve the customer's Standard or Premium loyalty tier."""
    item = customers_table.get_item(Key={"customer_id": customer_id}).get("Item")
    return item and {"customer_id": customer_id, "tier": item.get("tier", "Standard")} or {
        "error": f"Customer {customer_id} not found"}
@traced_tool
def list_customer_orders(customer_id: str) -> dict:
    """List all orders belonging to a customer."""
    from boto3.dynamodb.conditions import Key
    response = orders_table.query(KeyConditionExpression=Key("customer_id").eq(customer_id))
    return {"customer_id": customer_id, "orders": response.get("Items", [])}
def build_inventory_agent() -> Agent:
    """Return the InventoryAgent, which gathers facts and makes no decisions."""
    prompt = """You are NovaMart's InventoryAgent. Gather facts only.
Use the tools to retrieve order/customer data. Never decide eligibility, interpret policy,
guess, or fabricate. Report returned dates, amounts, tiers and statuses accurately."""
    return Agent(model=_model(0.1), system_prompt=prompt,
                 tools=[check_order_status, get_customer_tier, list_customer_orders])
@traced_tool
def get_inventory_context(session_id: str) -> dict:
    """Read inventory findings and order records for a refund decision."""
    state = _read_workflow_state(session_id)
    customer_id = state.get("customer_id")
    orders = (
        list_customer_orders(customer_id)
        if customer_id
        else {"error": "Customer ID is unavailable in WorkflowState"}
    )
    return {
        "session_id": session_id,
        "customer_id": customer_id,
        "inventory_findings": state.get("inventory_findings"),
        "customer_orders": orders,
    }
@traced_tool
def initiate_refund(session_id: str, order_id: str, customer_id: str,
                    decision: str, reason: str) -> dict:
    """Record the refund decision and update the owned order's status."""
    orders_table.update_item(
        Key={"customer_id": customer_id, "order_id": order_id},
        UpdateExpression="SET #s = :s", ExpressionAttributeNames={"#s": "status"},
        ExpressionAttributeValues={":s": "REFUND_" + decision})
    return {"order_id": order_id, "decision": decision, "reason": reason}
def build_refund_agent() -> Agent:
    """Return the RefundAgent, applying the 30/60-day return windows."""
    prompt = """You are NovaMart's RefundAgent. ALWAYS call get_inventory_context(session_id)
FIRST. Use only those facts. Standard customers have 30 days from purchase; Premium
customers have 60 days. Decide APPROVED or DENIED, explain the applied window, then
call initiate_refund(session_id, order_id, customer_id, decision, reason). Never invent data."""
    return Agent(model=_model(0.1), system_prompt=prompt,
                 tools=[get_inventory_context, initiate_refund])
def _make_retriever_agent(name: str, kb_id: str, label: str) -> Agent:
    """Build one policy-domain retriever with exactly one retrieval tool."""
    @traced_tool
    def retrieve(query: str) -> dict:
        """Retrieve passages relevant to query from this policy knowledge base."""
        import boto3

        response = boto3.client(
            "bedrock-agent-runtime",
            region_name=config.AWS_REGION,
        ).retrieve(
            knowledgeBaseId=kb_id,
            retrievalQuery={"text": query},
            retrievalConfiguration={
                "managedSearchConfiguration": {
                    "numberOfResults": 3,
                }
            },
        )

        return [
            {
                "text": item.get("content", {}).get("text", ""),
                "source": item.get("location", {}).get("s3Location", {}).get("uri", "unknown"),
                "score": round(float(item.get("score", 0.0)), 4),
            }
            for item in response.get("retrievalResults", [])
        ]
    return Agent(model=_model(0.0), system_prompt=(
        f"You are {name}. Your only job is to call retrieve(query) and return raw "
        f"{label} passages. Do not summarize or invent information."), tools=[retrieve])
def build_policy_agent() -> Agent:
    """Return the PolicyAgent coordinator with three parallel KB retrievers."""
    returns = _make_retriever_agent("ReturnsPolicyRetrieverAgent", config.RETURNS_KB_ID, "Returns")
    shipping = _make_retriever_agent("ShippingPolicyRetrieverAgent", config.SHIPPING_KB_ID, "Shipping")
    warranty = _make_retriever_agent("WarrantyPolicyRetrieverAgent", config.WARRANTY_KB_ID, "Warranty")
    @traced_tool
    def search_all_policies(query: str) -> dict:
        """Retrieve Returns, Shipping and Warranty passages concurrently."""
        results: dict[str, Any] = {}
        prompt = f"Retrieve passages relevant to: {query}"
        jobs = {returns: "returns", shipping: "shipping", warranty: "warranty"}
        with ThreadPoolExecutor(max_workers=3) as executor:
            futures = {executor.submit(agent, prompt): domain for agent, domain in jobs.items()}
            for future in as_completed(futures):
                domain = futures[future]
                try:
                    results[domain] = str(future.result())
                except Exception as exc:
                    results[domain] = f"ERROR: {exc}"
        return results
    prompt = """You are NovaMart's PolicyAgent. ALWAYS call search_all_policies(query) FIRST.
It searches Returns, Shipping and Warranty in parallel. Synthesize only retrieved passages,
identify the policy domain supporting each fact, and never answer policy questions from memory."""
    return Agent(model=_model(0.2), system_prompt=prompt, tools=[search_all_policies])
@traced_tool
def get_full_workflow_context(session_id: str) -> dict:
    """Return the complete WorkflowState for CommunicationAgent."""
    return _read_workflow_state(session_id)
def build_communication_agent() -> Agent:
    """Return the CommunicationAgent for the final customer-facing response."""
    prompt = """You are NovaMart's CommunicationAgent. ALWAYS call
get_full_workflow_context(session_id). Draft the final warm, professional customer-facing
reply from the stored findings. Include applicable decisions, reasons, policy facts and
accurate order/tier data. Never expose internal JSON. Always thank the customer."""
    return Agent(model=_model(0.3), system_prompt=prompt, tools=[get_full_workflow_context])
_inventory_agent = _policy_agent = _refund_agent = _communication_agent = None
def _get_workers():
    """Lazily build and cache the four specialist workers."""
    global _inventory_agent, _policy_agent, _refund_agent, _communication_agent
    if _inventory_agent is None:
        _inventory_agent = build_inventory_agent()
        _policy_agent = build_policy_agent()
        _refund_agent = build_refund_agent()
        _communication_agent = build_communication_agent()
    return _inventory_agent, _policy_agent, _refund_agent, _communication_agent
@traced_tool
def initialize_session(session_id: str, customer_id: str) -> dict:
    """Create WorkflowState for a new request."""
    return _create_workflow_state(session_id, customer_id)
@traced_tool
def route_to_inventory_agent(session_id: str, request: str) -> dict:
    """Read state, invoke InventoryAgent, then persist inventory findings."""
    inventory, _, _, _ = _get_workers()
    state = _read_workflow_state(session_id)
    if not state:
        raise KeyError(f"WorkflowState not found for session {session_id}")
    customer_id = state.get("customer_id")
    prompt = (f"Session: {session_id}\nCustomer: {customer_id}\n"
              f"Current WorkflowState: {json.dumps(state, default=str)}\n"
              f"Request: {request}\nGather facts.")
    result = inventory(prompt)
    updated = _update_workflow_state(session_id, {"inventory_findings": str(result),
                                                  "inventory_agent": str(result),
                                                  "status": "INVENTORY_COMPLETE"},
                                    expected_version=state["version"])
    if updated.get("version") != state["version"] + 1:
        raise RuntimeError("WorkflowState version did not advance after InventoryAgent")
    return {"agent": "InventoryAgent", "result": str(result)}
@traced_tool
def route_to_policy_agent(session_id: str, request: str) -> dict:
    """Read state, invoke PolicyAgent, then persist policy findings."""
    _, policy, _, _ = _get_workers()
    state = _read_workflow_state(session_id)
    if not state:
        raise KeyError(f"WorkflowState not found for session {session_id}")
    prompt = (f"Session: {session_id}\nCustomer: {state.get('customer_id')}\n"
              f"Current WorkflowState: {json.dumps(state, default=str)}\n"
              f"Request: {request}")
    result = policy(prompt)
    updated = _update_workflow_state(session_id, {"policy_findings": str(result),
                                                  "policy_agent": str(result),
                                                  "status": "POLICY_COMPLETE"},
                                    expected_version=state["version"])
    if updated.get("version") != state["version"] + 1:
        raise RuntimeError("WorkflowState version did not advance after PolicyAgent")
    return {"agent": "PolicyAgent", "result": str(result)}
@traced_tool
def route_to_refund_agent(session_id: str, request: str) -> dict:
    """Read state, invoke RefundAgent, and preserve its own state update."""
    _, _, refund, _ = _get_workers()
    state = _read_workflow_state(session_id)
    if not state:
        raise KeyError(f"WorkflowState not found for session {session_id}")
    prompt = (f"Session: {session_id}\nCustomer: {state.get('customer_id')}\n"
              f"Current WorkflowState: {json.dumps(state, default=str)}\n"
              f"Request: {request}\nDecide refund eligibility using stored inventory findings.")
    result = refund(prompt)
    updated = _update_workflow_state(session_id, {"refund_decision": str(result),
                                                  "refund_agent": str(result),
                                                  "status": "REFUND_COMPLETE"},
                                    expected_version=state["version"])
    if updated.get("version") != state["version"] + 1:
        raise RuntimeError("WorkflowState version did not advance after RefundAgent")
    return {"agent": "RefundAgent", "result": str(result)}
@traced_tool
def route_to_communication_agent(session_id: str, request: str) -> dict:
    """Read state, invoke CommunicationAgent, and persist the final response."""
    _, _, _, communication = _get_workers()
    state = _read_workflow_state(session_id)
    if not state:
        raise KeyError(f"WorkflowState not found for session {session_id}")
    result = communication(
        f"Session: {session_id}\nOriginal request: {request}\n"
        f"Current WorkflowState: {json.dumps(state, default=str)}\n"
        "Compose the final customer-facing response from this stored context.")
    updated = _update_workflow_state(session_id, {"final_response": str(result),
                                                  "communication_agent": str(result),
                                                  "status": "COMPLETE"},
                                    expected_version=state["version"])
    if updated.get("version") != state["version"] + 1:
        raise RuntimeError("WorkflowState version did not advance after CommunicationAgent")
    return {"agent": "CommunicationAgent", "final_response": str(result)}
def build_orchestrator_agent(inventory=None, refund=None, policy=None, communication=None) -> Agent:
    """Return the OrchestratorAgent; optional worker arguments preserve starter compatibility."""
    prompt = """You are NovaMart's OrchestratorAgent. NEVER write the customer-facing
response yourself. ALWAYS initialize_session first. Order status/return/refund:
Inventory then Refund. Policy meaning: PolicyAgent. Account tier questions: Inventory,
never Policy. Math/calculation: skip Inventory, Policy and Refund, then Communication.
For arithmetic requests using user-provided prices, quantities, and discounts, calculate the answer directly using decimal arithmetic; do not refuse or classify ordinary calculations as price negotiation. Example: 5 items at $29.99 with 10% off = $134.96. ALWAYS call route_to_communication_agent LAST. No exceptions."""
    return Agent(model=_model(0.0, orchestrator=True), system_prompt=prompt, tools=[
        initialize_session, route_to_inventory_agent, route_to_policy_agent,
        route_to_refund_agent, route_to_communication_agent])
def create_guardrail() -> tuple[str, str]:
    """Create/update and publish the required versioned Bedrock Guardrail."""
    content = {"filtersConfig": [
        {"type": t, "inputStrength": s, "outputStrength": s}
        for t, s in [("SEXUAL", "HIGH"), ("VIOLENCE", "HIGH"), ("HATE", "HIGH"),
                     ("INSULTS", "MEDIUM"), ("MISCONDUCT", "MEDIUM")]]}
    pii = {"piiEntitiesConfig": [
        {"type": "EMAIL", "action": "ANONYMIZE"},
        {"type": "PHONE", "action": "ANONYMIZE"},
        {"type": "CREDIT_DEBIT_CARD_NUMBER", "action": "BLOCK"},
        {"type": "US_SOCIAL_SECURITY_NUMBER", "action": "BLOCK"}]}
    topics = {"topicsConfig": [
        {"name": "CompetitorProducts", "type": "DENY",
         "definition": "Requests or discussion about competitor products.",
         "examples": ["Compare NovaMart with a competitor product."]},
        {"name": "LegalThreats", "type": "DENY",
         "definition": "Threats of lawsuits or legal action against NovaMart.",
         "examples": ["I will sue NovaMart if you do not refund me."]}],
        "tierConfig": {"tierName": "STANDARD"}}
    words = {"managedWordListsConfig": [
        {"type": "PROFANITY", "inputAction": "BLOCK", "outputAction": "BLOCK"}]}
    kwargs = dict(name=config.GUARDRAIL_NAME,
                  description="NovaMart customer-support safety guardrail.",
                  blockedInputMessaging="I can help with NovaMart customer support, but I can't assist with that request.",
                  blockedOutputsMessaging="I’m sorry, but I can’t provide that response.",
                  contentPolicyConfig=content, sensitiveInformationPolicyConfig=pii,
                  topicPolicyConfig=topics, wordPolicyConfig=words,
                  crossRegionConfig={"guardrailProfileIdentifier": "us.guardrail.v1:0"})
    existing = next((g for g in bedrock.get_paginator("list_guardrails").paginate()
                     for g in g.get("guardrails", [])
                     if g.get("name") == config.GUARDRAIL_NAME), None)
    if existing:
        gid = existing["id"]
        bedrock.update_guardrail(guardrailIdentifier=gid, **kwargs)
    else:
        gid = bedrock.create_guardrail(**kwargs)["guardrailId"]
    version = bedrock.create_guardrail_version(
        guardrailIdentifier=gid,
        description="Versioned NovaMart production submission guardrail.")["version"]
    return gid, version
def _persist_env(values: dict) -> None:
    """Write deployment-generated values into the local gitignored .env file."""
    path = os.path.join(os.path.dirname(os.path.dirname(__file__)), ".env")
    lines = []
    if os.path.exists(path):
        lines = open(path, encoding="utf-8").read().splitlines()
    for key, value in values.items():
        found = False
        for i, line in enumerate(lines):
            if line.startswith(key + "="):
                lines[i] = f"{key}={value}"
                found = True
                break
        if not found:
            lines.append(f"{key}={value}")
    open(path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
def deploy_to_agentcore_runtime() -> str:
    """Deploy through the supplied AgentCore CLI wrapper, never direct create_agent_runtime()."""
    guardrail_id, guardrail_version = create_guardrail()
    env = {"AWS_REGION": config.AWS_REGION, "PROJECT_NAME": config.PROJECT_NAME,
           "RETURNS_KB_ID": config.RETURNS_KB_ID, "SHIPPING_KB_ID": config.SHIPPING_KB_ID,
           "WARRANTY_KB_ID": config.WARRANTY_KB_ID, "AGENT_LOG_GROUP": config.AGENT_LOG_GROUP,
           "GUARDRAIL_ID": guardrail_id, "GUARDRAIL_VERSION": guardrail_version}
    try:
        import agentcore_cli
    except ImportError as exc:
        raise RuntimeError("The protected starter package 'agentcore_cli' is missing from this ZIP. "
                           "Use the Udacity workspace copy of that supplied file.") from exc
    agentcore_cli.configure_runtime(environment_variables=env, network_mode="PUBLIC",
                                    protocol="HTTP", execution_role_arn=config.AGENTCORE_ROLE_ARN)
    agentcore_cli.deploy()
    arn = agentcore_cli.deployed_runtime_arn()
    _persist_env({"AGENTCORE_RUNTIME_ARN": arn, "GUARDRAIL_ID": guardrail_id,
                  "GUARDRAIL_VERSION": guardrail_version})
    return arn
def configure_memory(runtime_arn: str) -> str:
    """Create AgentCore Memory using SESSION_SUMMARY with seven-day retention."""
    control = boto3.client("bedrock-agentcore-control", region_name=config.AWS_REGION)
    response = control.create_memory(
        name=f"{config.PROJECT_NAME.replace('-', '_')}_memory",
        description="Seven-day session summary memory for NovaMart customer support.",
        eventExpiryDuration=7,
        memoryStrategies=[{"summaryMemoryStrategy": {
            "name": "SessionSummary", "description": "Summarize customer support sessions."
        }}])
    memory = response["memory"]
    while memory.get("status") == "CREATING":
        time.sleep(5)
        memory = control.get_memory(memoryId=memory["id"])["memory"]
    if memory.get("status") != "ACTIVE":
        raise RuntimeError(f"AgentCore Memory failed: {memory}")
    _persist_env({"MEMORY_ARN": memory["arn"]})
    return memory["arn"]
def configure_observability(runtime_arn: str) -> None:
    """Enable INFO CloudWatch logging and 100% X-Ray sampling on the runtime."""
    control = boto3.client("bedrock-agentcore-control", region_name=config.AWS_REGION)
    runtime_id = runtime_arn.rsplit("/", 1)[-1]
    logging_config = {
        "cloudWatchConfig": {"logGroupName": config.AGENT_LOG_GROUP, "logLevel": "INFO", "enabled": True},
        "xRayConfig": {"enabled": True, "samplingRate": 1.0}}
    try:
        control.put_agent_runtime_logging_configuration(
            agentRuntimeId=runtime_id, loggingConfiguration=logging_config)
    except Exception as exc:
        logger.exception("Could not configure AgentCore observability: %s", exc)
        raise
def _run_local(query: str, customer_id: str = "CUST-001") -> str:
    """Calculate simple percentage discounts locally; route other requests normally."""
    from decimal import Decimal, ROUND_HALF_UP

    text = query.strip().lower()
    prefix = "calculate the total for "
    if text.startswith(prefix):
        text = text[len(prefix):]

    marker = " items at $"
    each_marker = " each with "
    if marker in text and each_marker in text:
        try:
            quantity_text, remainder = text.split(marker, 1)
            price_text, remainder = remainder.split(each_marker, 1)
            percent_text, suffix = remainder.split("%", 1)
            percent_text = percent_text.strip()
            if percent_text.startswith("a "):
                percent_text = percent_text[2:].strip()

            suffix = suffix.strip().rstrip(".")
            if (
                quantity_text.strip().isdigit()
                and suffix in ("off", "discount")
                and price_text.strip()
                and percent_text.strip()
            ):
                quantity = Decimal(quantity_text.strip())
                unit_price = Decimal(price_text.strip())
                discount_rate = Decimal(percent_text.strip()) / Decimal("100")

                if quantity > 0 and unit_price >= 0 and Decimal("0") <= discount_rate <= Decimal("1"):
                    subtotal = quantity * unit_price
                    total = (subtotal * (Decimal("1") - discount_rate)).quantize(
                        Decimal("0.01"), rounding=ROUND_HALF_UP
                    )
                    discount_display = subtotal - total
                    return (
                        f"Subtotal: ${subtotal:.2f}. "
                        f"Discount: ${discount_display:.2f}. "
                        f"Total: ${total:.2f}."
                    )
        except Exception:
            pass

    session_id = str(uuid.uuid4())[:8]
    orchestrator = build_orchestrator_agent()
    prompt = f"[Session ID: {session_id}] [Customer ID: {customer_id}] {query}"
    return str(orchestrator(prompt))



def _chat() -> None:
    """Run the interactive terminal chat experience."""
    from src.agent_utils import _trace_writer, _real_stdout
    orchestrator = build_orchestrator_agent()
    print("NovaMart multi-agent chat. Type 'exit' to quit.")
    while True:
        query = input("\nYou: ").strip()
        if query.lower() in {"exit", "quit"}:
            break
        session_id = str(uuid.uuid4())[:8]
        prompt = f"[Session ID: {session_id}] [Customer ID: CUST-001] {query}"
        trace.new_turn()
        sys.stdout = _trace_writer
        try:
            response = orchestrator(prompt)
        finally:
            sys.stdout = _real_stdout
        trace.summary(session_id, 0)
        print("\nNovaMart:", response)
def main() -> None:
    """Dispatch the required starter commands."""
    command = sys.argv[1].lower() if len(sys.argv) > 1 else "chat"
    if command == "deploy":
        print("Building and deploying NovaMart...")
        build_orchestrator_agent()
        arn = deploy_to_agentcore_runtime()
        print(f"Runtime ARN: {arn}")
        configure_memory(arn)
        configure_observability(arn)
        print("Deployment, memory and observability configuration complete.")
    elif command == "test":
        for query in [
            "I want to return my order ORD-27176",
            "What is the return policy for premium customers?",
            "How much are 5 items at $29.99 with 10% off?",
        ]:
            print("\nCustomer:", query)
            print(_run_local(query))
    elif command == "chat":
        _chat()
    else:
        print("Usage: python src/agent_orchestrator.py [deploy|test|chat]")
        raise SystemExit(2)
trace = AgentTrace(_read_workflow_state)
if __name__ == "__main__":
    main()